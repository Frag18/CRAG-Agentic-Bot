# Environment variables for Agentic RAG System

# Primary LLM: Google Gemini (e.g. gemini-2.0-flash-lite / gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Fallback LLM: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Alternative LLM Provider (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding Configuration (runs locally with sentence-transformers by default)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=6
MAX_RETRIES=1
